# Copy to .env and fill in only on the machine that runs the API.
# Never commit the filled file.

PREDICTION_MODEL_PATH=
INCIDENT_CSV_PATH=
PREDICTION_CORS_ORIGINS=http://localhost:5173
PREDICTION_RATE_LIMIT_PER_MINUTE=60
PREDICTION_FORECAST_CACHE_TTL_S=900

# Optional. Without it, /routes returns an unscored Google Maps link.
GOOGLE_ROUTES_API_KEY=

# Optional GeoJSON of GAUL 2024 level 1 or 2. Without it, only the labelled pilot box is served.
GAUL_GEOJSON=

# Used only by the optional Earth Engine path in Nature data/main.py.
GEE_PROJECT_ID=
