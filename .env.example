# DOAB Platform Environment Variables (Example Template)
# Copy to .env. Do not commit the filled file.

VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_OPENROUTER_API_KEY=
VITE_PREDICTION_API_URL=http://127.0.0.1:8000

# Amazon Location Service — Cognito Identity Pool (unauthenticated, read-only)
# Pool: doab-als-pool | Index: doab-place-index | Region: ap-southeast-2
# This ID is safe to embed — it only grants geo:SearchPlaceIndex* on one resource.
VITE_AWS_COGNITO_IDENTITY_POOL_ID=ap-southeast-2:ff8ccdf5-4e7a-45c8-861d-51221d0ea28d
